# Local development only. Do not place production credentials here.
# Docker Compose project name controls the names of persistent volumes.
ITSOFT_COMPOSE_PROJECT_NAME=itsoft-local
ITSOFT_HTTP_PORT=8080
ITSOFT_MAILPIT_PORT=8025
ITSOFT_LOCAL_URL=http://localhost:8080
ITSOFT_WP_ENVIRONMENT_TYPE=local
ITSOFT_EXTERNAL_INTEGRATIONS_DISABLED=1
ITSOFT_PAYMENT_INTEGRATIONS_ENABLED=0
ITSOFT_MOCK_PAYMENT_ENABLED=1
ITSOFT_WP_SALT=itsoft-local-salt-do-not-use-on-public-servers
ITSOFT_LICENSE_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ITSOFT_DB_NAME=itsoft_local
ITSOFT_DB_USER=itsoft
ITSOFT_DB_PASSWORD=itsoft_local_only
ITSOFT_DB_ROOT_PASSWORD=itsoft_root_local_only
