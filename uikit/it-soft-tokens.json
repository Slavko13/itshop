  "avatar": {
    "sizes": [
      32,
      40,
      48
    ],
    "radii": {
      "32": 8,
      "40": 12,
      "48": 14
    },
    "fallback": "initials or user-round",
    "min-hit-area": 44
  },
  "field-extended": {
    "readonly-focusable": true,
    "validation": "first blur or submit, then input",
    "helper-min-height": 32,
    "textarea-height": 112,
    "textarea-radius": 12,
    "textarea-counter": "Unicode code points; must match backend policy",
    "mobile-font-size": 16,
    "mobile-line-height": 24
  },
  "data-table": {
    "header-height": 48,
    "row-min-height": 72,
    "cell-padding-x": 12,
    "row-padding-y": 8,
    "select-cell-padding-x": 0,
    "columns": [
      {
        "id": "select",
        "width": 52,
        "flex": false
      },
      {
        "id": "order",
        "width": 116,
        "flex": false
      },
      {
        "id": "date",
        "width": 128,
        "flex": false
      },
      {
        "id": "product",
        "width": null,
        "flex": true
      },
      {
        "id": "status",
        "width": 176,
        "flex": false
      },
      {
        "id": "amount",
        "width": 132,
        "flex": false
      },
      {
        "id": "action",
        "width": 144,
        "flex": false
      }
    ],
    "amount-align": "right",
    "mobile": "stacked definition list",
    "breakpoint": 768
  },
  "combobox": {
    "height": 48,
    "option-height": 44,
    "list-padding": 8,
    "max-visible-options": 6,
    "search-debounce-ms": 300,
    "selection": "manual commit"
  },
  "filter": {
    "commit": "explicit apply",
    "empty-bound": "unbounded",
    "validation": "min <= max",
    "reset": "defaults and page 1"
  },
  "dialog": {
    "width-max": 520,
    "viewport-margin": 16,
    "padding": 24,
    "radius": 16,
    "initial-focus-danger": "cancel",
    "escape": "close and restore trigger",
    "pending-repeat": "blocked"
  },
  "drawer": {
    "width-max": 400,
    "padding": 20,
    "radius": 16,
    "behavior": "modal"
  },
  "popover": {
    "radius": 12,
    "padding": 8,
    "option-height": 44
  },
  "license": {
    "value-min-height": 64,
    "code-font": "Menlo, Consolas, monospace",
    "code-size": 13,
    "code-line-height": 20,
    "mask": "display only",
    "availability-source": "backend"
  },
  "coupon": {
    "server-validation": true,
    "trim": "edges only, preserve case",
    "pending-repeat": "blocked"
  },
  "breakpoints": {
    "mobile-max": 767,
    "desktop-min": 768,
    "wide-min": 1024
  },
  "motion": {
    "color-ms": 120,
    "popover-ms": 160,
    "dialog-ms": 200,
    "easing": "ease",
    "reduced-motion": "none"
  },
  "layers": {
    "base": 0,
    "dropdown": 100,
    "popover": 200,
    "backdrop": 300,
    "dialog": 400,
    "toast": 500,
    "tooltip": 600
  }
}